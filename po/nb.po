msgstr "_Avbryt spill"

#: src/gnome-chess.vala:997
msgid "Save game for later"
msgstr "Lagre spill til senere"

#: src/gnome-chess.vala:1003
msgid "_Discard Game"
msgstr "_Forkast spill"

